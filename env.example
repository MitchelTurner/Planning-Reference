# Required: your Claude API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Strongly recommended: anyone with the link needs this to use Ask (the reference pages stay open)
APP_PASSCODE=choose-a-passcode

# Optional. Leave CLAUDE_MODEL unset, or set CLAUDE_MODEL=claude-opus-5-5,
# to use the newest Claude Opus (Opus 5.5 today; a newer Opus when Anthropic releases one).
# Set any other id to pin that model.
CACHE_TTL=1h
MAX_TOKENS=8000
RATE_LIMIT_PER_MIN=20
